		{
			"name": "🌊 Scenario 1: Complete Public Pooling Flow",
			"description": "Complete flow for a user creating a public pooling group with trip planning",
			"item": [
				{
					"name": "Step 1: Pre-check Compatible Groups",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has status field', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('status');",
									"});",
									"",
									"pm.test('Response has compatible groups', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('compatibleGroups');",
									"    pm.expect(jsonData.compatibleGroups).to.be.an('array');",
									"});",
									"",
									"// Store response for next request",
									"pm.globals.set('precheck_response', JSON.stringify(pm.response.json()));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{user_id}}\",\n    \"baseCity\": \"Colombo\",\n    \"startDate\": \"2025-10-15\",\n    \"endDate\": \"2025-10-20\",\n    \"budgetLevel\": \"Medium\",\n    \"preferredActivities\": [\"Cultural Tours\", \"Beach Activities\"],\n    \"preferredTerrains\": [\"Beach\", \"Cultural Sites\"],\n    \"activityPacing\": \"Normal\",\n    \"multiCityAllowed\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/public-pooling/pre-check",
							"host": ["{{base_url}}"],
							"path": ["public-pooling", "pre-check"]
						}
					},
					"response": []
				},
				{
					"name": "Step 2: Create Group with Trip Planning",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has group and trip IDs', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('groupId');",
									"    pm.expect(jsonData).to.have.property('tripId');",
									"    pm.expect(jsonData.groupId).to.not.be.empty;",
									"    pm.expect(jsonData.tripId).to.not.be.empty;",
									"});",
									"",
									"// Store IDs for subsequent requests",
									"pm.globals.set('created_group_id', pm.response.json().groupId);",
									"pm.globals.set('created_trip_id', pm.response.json().tripId);",
									"",
									"pm.test('Response indicates awaiting trip completion', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData.status).to.equal('awaiting_trip_completion');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{user_id}}\",\n    \"userEmail\": \"{{user_email}}\",\n    \"groupName\": \"Sri Lanka Cultural Explorer\",\n    \"tripName\": \"Amazing Sri Lanka Cultural Journey\",\n    \"startDate\": \"2025-10-15\",\n    \"endDate\": \"2025-10-20\",\n    \"baseCity\": \"Colombo\",\n    \"arrivalTime\": \"14:30\",\n    \"multiCityAllowed\": true,\n    \"activityPacing\": \"Normal\",\n    \"budgetLevel\": \"Medium\",\n    \"preferredTerrains\": [\"Beach\", \"Cultural Sites\", \"Mountain\"],\n    \"preferredActivities\": [\"Cultural Tours\", \"Beach Activities\", \"Hiking\"],\n    \"visibility\": \"public\",\n    \"maxMembers\": 8,\n    \"requiresApproval\": true,\n    \"additionalPreferences\": {\n        \"accommodationType\": \"mid-range hotels\",\n        \"transportPreference\": \"private vehicle\",\n        \"dietaryRequirements\": \"vegetarian options available\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/groups/with-trip",
							"host": ["{{base_url}}"],
							"path": ["groups", "with-trip"]
						}
					},
					"response": []
				},
				{
					"name": "Step 3: Save Trip with Suggestions",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has suggestions', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData).to.have.property('suggestions');",
									"});",
									"",
									"// Store suggestion data",
									"pm.globals.set('trip_suggestions', JSON.stringify(pm.response.json()));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{user_id}}\",\n    \"tripId\": \"{{created_trip_id}}\",\n    \"tripData\": {\n        \"tripName\": \"Amazing Sri Lanka Cultural Journey\",\n        \"startDate\": \"2025-10-15\",\n        \"endDate\": \"2025-10-20\",\n        \"baseCity\": \"Colombo\",\n        \"cities\": [\"Colombo\", \"Kandy\", \"Galle\"],\n        \"destinations\": [\"Colombo\", \"Kandy\", \"Galle\"],\n        \"places\": [\n            {\n                \"name\": \"Gangaramaya Temple\",\n                \"city\": \"Colombo\",\n                \"type\": \"Cultural\",\n                \"day\": 1\n            },\n            {\n                \"name\": \"Temple of the Tooth\",\n                \"city\": \"Kandy\",\n                \"type\": \"Cultural\",\n                \"day\": 2\n            },\n            {\n                \"name\": \"Galle Fort\",\n                \"city\": \"Galle\",\n                \"type\": \"Historical\",\n                \"day\": 3\n            }\n        ],\n        \"activities\": [\"Cultural Tours\", \"Photography\", \"Local Cuisine\"],\n        \"terrains\": [\"Cultural Sites\", \"Coastal Areas\"],\n        \"itinerary\": [\n            {\n                \"day\": 1,\n                \"date\": \"2025-10-15\",\n                \"city\": \"Colombo\",\n                \"activities\": [\"Gangaramaya Temple\", \"National Museum\", \"Pettah Market\"]\n            },\n            {\n                \"day\": 2,\n                \"date\": \"2025-10-16\",\n                \"city\": \"Kandy\",\n                \"activities\": [\"Temple of the Tooth\", \"Royal Botanical Gardens\", \"Kandy Lake\"]\n            },\n            {\n                \"day\": 3,\n                \"date\": \"2025-10-17\",\n                \"city\": \"Galle\",\n                \"activities\": [\"Galle Fort\", \"Unawatuna Beach\", \"Stilt Fishermen\"]\n            }\n        ]\n    },\n    \"optionalField\": \"Additional trip metadata\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/public-pooling/groups/{{created_group_id}}/save-trip",
							"host": ["{{base_url}}"],
							"path": ["public-pooling", "groups", "{{created_group_id}}", "save-trip"]
						}
					},
					"response": []
				},
				{
					"name": "Step 4A: Finalize Group (Keep New Group)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Group finalized successfully', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData.status).to.be.oneOf(['success', 'finalized']);",
									"});",
									"",
									"pm.test('Group is now active', function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.groupStatus) {",
									"        pm.expect(jsonData.groupStatus).to.equal('finalized');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{user_id}}\",\n    \"action\": \"finalize\",\n    \"reason\": \"Proceeding with our planned group trip\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/public-pooling/groups/{{created_group_id}}/finalize",
							"host": ["{{base_url}}"],
							"path": ["public-pooling", "groups", "{{created_group_id}}", "finalize"]
						}
					},
					"response": []
				},
				{
					"name": "Step 4B: Alternative - Join Existing Group",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Join existing group successful', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData.status).to.equal('success');",
									"});",
									"",
									"pm.test('Original group discarded', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('originalGroupStatus');",
									"    pm.expect(jsonData.originalGroupStatus).to.equal('discarded');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{user_id}}\",\n    \"targetGroupId\": \"existing-group-id-from-suggestions\",\n    \"message\": \"I'd like to join your group instead of creating my own. Our itineraries seem very compatible!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/public-pooling/groups/{{created_group_id}}/join-existing",
							"host": ["{{base_url}}"],
							"path": ["public-pooling", "groups", "{{created_group_id}}", "join-existing"]
						}
					},
					"response": []
				}
			]
		},
