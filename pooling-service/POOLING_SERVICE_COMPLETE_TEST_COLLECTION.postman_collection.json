									"",
									"pm.test('Filtered results returned', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"});",
									"",
									"pm.test('Results match filter criteria', function () {",
									"    var jsonData = pm.response.json();",
									"    jsonData.forEach(function(group) {",
									"        // Check if budget level matches",
									"        if (group.budgetLevel) {",
									"            pm.expect(group.budgetLevel).to.equal('Medium');",
									"        }",
									"        // Check if base city matches",
									"        if (group.baseCity) {",
									"            pm.expect(group.baseCity).to.equal('Colombo');",
									"        }",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
