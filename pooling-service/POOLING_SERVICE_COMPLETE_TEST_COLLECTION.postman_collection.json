		{
			"name": "🔍 Scenario 3: Group Discovery & Browsing",
			"description": "User discovering and browsing available public groups",
			"item": [
				{
					"name": "Browse All Enhanced Public Groups",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Public groups array returned', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"});",
									"",
									"pm.test('Groups have required fields', function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.length > 0) {",
									"        var firstGroup = jsonData[0];",
									"        pm.expect(firstGroup).to.have.property('groupId');",
									"        pm.expect(firstGroup).to.have.property('tripName');",
									"        pm.expect(firstGroup).to.have.property('baseCity');",
									"        pm.expect(firstGroup).to.have.property('startDate');",
									"        pm.expect(firstGroup).to.have.property('endDate');",
									"    }",
									"});",
									"",
									"// Store first group ID for joining test",
									"var jsonData = pm.response.json();",
									"if (jsonData.length > 0) {",
									"    pm.globals.set('browsable_group_id', jsonData[0].groupId);",
